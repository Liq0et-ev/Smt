# Copy this file to .env and fill in your own values. Never commit .env.

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=your_org-your_account   # e.g. xzwiguk-ck25170 (see: Admin > Accounts > Account/Server URL)
SNOWFLAKE_USER=your_username

# Auth: use ONE of the two options below.
# Option A (preferred) -- key-pair auth, avoids password/MFA issues entirely:
SNOWFLAKE_PRIVATE_KEY_PATH=/home/you/.ssh/snowflake_keys/snowflake_rsa_key.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=only_if_you_encrypted_the_key
#
# Option B -- password auth:
# SNOWFLAKE_PASSWORD=your_password

SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=COVID_WH
SNOWFLAKE_DATABASE=COVID19_PLATFORM
SNOWFLAKE_SCHEMA=GOLD
# Database/schema of the Marketplace share (read-only)
SNOWFLAKE_MARKETPLACE_DATABASE=COVID19_EPIDEMIOLOGICAL_DATA
SNOWFLAKE_MARKETPLACE_SCHEMA=PUBLIC

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=covid_platform

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
